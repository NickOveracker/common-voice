# Example settings for a private, self-hosted deployment.
# See FORK.md. Settings not listed here are documented in
# .env-local-docker.example and server/src/config-helper.ts.

# --- Site ---
CV_ENVIRONMENT="prod"
CV_PROD="true"
CV_PUBLIC_URL="https://voice.example.org"

# --- Languages (server/src/fork/locales.ts) ---
# Interface languages. Replaces the Pontoon language import.
CV_LOCALES="en,ja,ain"
# Languages people can contribute recordings in.
CV_CONTRIBUTABLE_LOCALES="ain"

# --- Privacy ---
# Only signed-in users can use the API.
CV_REQUIRE_LOGIN="true"
CV_ROBOTS_DISALLOW_ALL="true"
CV_STRICT_CSP="true"
# Origin audio files are served from (signed URLs).
CV_STORAGE_ORIGIN="https://storage.example.org"
# Privacy notice and terms, as <document>.<locale>.md
# (privacy_notice.ja.md, terms.en.md, ...)
CV_LEGAL_DOCS_DIR="/srv/voice/legal"
# Leave empty to disable error reporting.
CV_SENTRY_DSN_SERVER=""

# --- Web build (read by webpack at build time) ---
# Builds the page template without analytics, donation widgets or Mozilla
# branding.
CV_PRIVATE_INSTANCE="true"

# --- Sign-in (any OpenID Connect provider, e.g. Keycloak) ---
# Restrict who can register at the identity provider: anyone who can sign in
# there can contribute.
CV_FXA_DOMAIN="https://auth.example.org/realms/voice"
CV_FXA_CLIENT_ID=""
CV_FXA_CLIENT_SECRET=""

# --- Secrets: generate new values, e.g. with `openssl rand -hex 32` ---
CV_SECRET=""
CV_JWT_KEY=""

# --- Database ---
CV_MYSQLHOST="db"
CV_MYSQLUSER="voicecommons"
CV_MYSQLPASS=""
CV_DB_ROOT_PASS=""
CV_REDIS_URL="redis"

# --- Email ---
CV_SMTP_URL="smtps://user:password@mail.example.org:465"
CV_EMAIL_USERNAME_FROM="voice@example.org"
CV_EMAIL_USERNAME_TO="voice@example.org"
