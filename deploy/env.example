# Copy to .env and fill in; setup.sh generates the secrets. Never commit .env.

# --- Addresses (Tailscale Serve, see README.md)
CV_PUBLIC_URL=https://nickserv.tail9014da.ts.net:8443
KEYCLOAK_PUBLIC_URL=https://nickserv.tail9014da.ts.net:10000
APP_PORT=18900
KEYCLOAK_PORT=18901

# --- Who is an admin from the start (comma-separated emails)
CV_ADMIN_EMAILS=
# Where deletion and email change requests go
CV_CONTACT_EMAIL=

# --- Secrets (generated by setup.sh)
CV_DB_ROOT_PASS=
CV_MYSQLUSER=voicecommons
CV_MYSQLPASS=
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_ADMIN_PASSWORD=
CV_SECRET=
CV_JWT_KEY=
CV_FXA_CLIENT_ID=ainu-voice
CV_FXA_CLIENT_SECRET=

# --- The app (see .env-private.example at the top of the repository)
CV_ENVIRONMENT=prod
CV_PROD=true
CV_IMPORT_SENTENCES=false
CV_LOCALES=en,ja,ain
CV_CONTRIBUTABLE_LOCALES=ain
CV_PRIVATE_INSTANCE=true
CV_REQUIRE_LOGIN=true
CV_ROBOTS_DISALLOW_ALL=true
CV_STRICT_CSP=true
CV_PRIVATE_STORAGE=true
# Email (password resets, notices): leave empty for now
CV_SMTP_URL=
